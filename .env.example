# ==============================================================================
# Single Source of Truth Configuration (`.env`)
# Copy this file to `.env` in the repository root (or let your AI Coding Assistant
# generate it via `python3 deploy/00_preflight_and_configure.py --write-config`):
#   cp .env.example .env
# ==============================================================================

# 1. Google Cloud Project & Region
PROJECT_ID="your-gcp-project-id"
REGION="us-central1"
BQ_LOCATION="US"

# 2. BigQuery Dataset & Table
BQ_DATASET="retail_sales"
BQ_TABLE="weekly_store_sales"

# 3. Admin & Regional Test User Emails (for BigQuery Row-Level Security & Gemini Enterprise)
#    • ADMIN_USER : Host/Admin account (full access across ALL regions: North, South, West)
#    • NORTH_USER : Test User 1 (filtered by RLS to `region = "North"` only)
#    • SOUTH_USER : Test User 2 (filtered by RLS to `region = "South"` only — optional)
#    • WEST_USER  : Test User 3 (filtered by RLS to `region = "West"` only — optional)
USER_DOMAIN="your-company.com"
ADMIN_USER="admin@your-company.com"
NORTH_USER="uno@your-company.com"
SOUTH_USER="dos@your-company.com"
WEST_USER="tres@your-company.com"

# 4. 3-Legged OAuth (3LO) Web Client Credentials
#    Either set these two values OR place your downloaded `client_secret_*.json` in the repo root.
#    Authorized Redirect URIs required on this Web Client:
#      • https://vertexaisearch.cloud.google.com/oauth-redirect  (For Gemini Enterprise)
#      • http://localhost:8000/dev-ui/                           (For local `adk web`)
OAUTH_CLIENT_ID=""
OAUTH_CLIENT_SECRET=""

# 5. Gemini Enterprise & ADK Runtime Settings (Defaults work out of the box)
GE_APP_ID="omni-retail-sales-ge"
GE_APP_DISPLAY_NAME="OmniRetail 3LO Sales Assistant"
AGENT_SERVICE_NAME="retail-sales-agent-id"
AGENT_DISPLAY_NAME="OmniRetail BigQuery 3LO Sales Agent"
AGENT_DESCRIPTION="Analyzes weekly store sales, margins, returns, and stockouts across regions using per-user 3-Legged OAuth (3LO) and BigQuery Row-Level Security (RLS)."
GEMINI_AUTH_ID="bq-3lo-auth"
SKIP_GEMINI_ENTERPRISE="false"

# 6. Vertex AI / ADK Runtime Defaults
GOOGLE_GENAI_USE_VERTEXAI="true"
GOOGLE_CLOUD_LOCATION="global"
