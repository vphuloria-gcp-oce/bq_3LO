# ==============================================================================
# BigQuery 3-Legged OAuth (3LO) & Row-Level Security (RLS) Demo Configuration
# Copy this file to `deploy/config.env` and customize for your environment:
#   cp deploy/config.env.example deploy/config.env
# ==============================================================================

# 1. Google Cloud Project & Location
export PROJECT_ID="bq-3lo"
export REGION="us-central1"
export BQ_LOCATION="US"

# 2. BigQuery Dataset & Table Identifiers
export BQ_DATASET="retail_sales"
export BQ_TABLE="weekly_store_sales"

# 3. Identity & Domain Configuration
# If USER_DOMAIN is set, ADMIN_USER and regional users default to <prefix>@${USER_DOMAIN}
export USER_DOMAIN="vphuloria.altostrat.com"

# Admin identity (uploads data and gets full access across all regions via `FILTER USING (TRUE)`)
export ADMIN_USER="admin@${USER_DOMAIN}"

# Regional Users (each gets Row-Level Access to exactly ONE region)
export NORTH_USER="uno@${USER_DOMAIN}"
export SOUTH_USER="dos@${USER_DOMAIN}"
export WEST_USER="tres@${USER_DOMAIN}"

# 4. Gemini Enterprise (Agentspace) & ADK Agent Configuration
export GE_APP_ID="omni-retail-sales-ge"
export GE_APP_DISPLAY_NAME="OmniRetail 3LO Sales Assistant"
export AGENT_DISPLAY_NAME="OmniRetail BigQuery 3LO Sales Agent"
export AGENT_DESCRIPTION="Analyzes weekly store sales, margins, returns, and stockouts across regions using per-user 3-Legged OAuth (3LO) and BigQuery Row-Level Security (RLS)."
export GEMINI_AUTH_ID="bq-3lo-auth"

# 5. 3-Legged OAuth (3LO) Web Client Credentials
# Either set these two variables OR drop your downloaded `client_secret_*.json` file into the repo root!
export OAUTH_CLIENT_ID="${OAUTH_CLIENT_ID:-}"
export OAUTH_CLIENT_SECRET="${OAUTH_CLIENT_SECRET:-}"
